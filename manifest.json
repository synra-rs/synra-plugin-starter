{
  "$schema": "https://synra-app.dev/schema/manifest/v1.json",
  "id": "@synra-plugin/starter",
  "version": "0.2.4",
  "title": "Synra Starter",
  "description": "Synra capability showcase, plugin reference and diagnostics.",
  "publisher": {
    "id": "synra-official",
    "name": "Synra"
  },
  "sdk": {
    "min": "0.1.0"
  },
  "wit": "synra:plugin@1.0.0",
  "runtime": {
    "headless": {
      "artifact": "plugin.wasm",
      "stateful": true
    },
    "ui": {
      "artifact": "ui.zip",
      "entry": "index.html"
    }
  },
  "capabilities": [
    {
      "cap": "device:list",
      "reason": "Show paired computers and their current connection status for explicit target selection."
    },
    {
      "cap": "device:send:*",
      "reason": "Send the selected showcase request to an explicitly chosen computer."
    },
    {
      "cap": "platform:open-url",
      "reason": "Open a URL on the computer receiving a showcase request."
    },
    {
      "cap": "platform:open-path",
      "reason": "Open a registered local application selected from the computer's application list."
    },
    {
      "cap": "platform:read-clipboard",
      "reason": "Read clipboard text on a computer for the clipboard demonstration."
    },
    {
      "cap": "platform:write-clipboard",
      "reason": "Write clipboard text on a computer for the clipboard demonstration."
    },
    {
      "cap": "action:declare:*",
      "reason": "Register Starter's diagnostic and showcase actions."
    },
    {
      "cap": "event:subscribe:_plugin.@synra-plugin/starter.*",
      "reason": "Receive the selected computer's response for Starter showcase requests."
    }
  ],
  "actions": [
    {
      "name": "debug",
      "description": "Read available host environment and plugin build information."
    },
    {
      "name": "starter.open-url",
      "description": "Ask an explicitly selected computer to open a supported URL.",
      "args": {
        "type": "object",
        "properties": { "target": { "type": "string" }, "requestId": { "type": "string" }, "url": { "type": "string" } },
        "required": ["target", "requestId", "url"],
        "additionalProperties": false
      }
    },
    {
      "name": "starter.clipboard-read-selection",
      "description": "Ask the selected computer for its current clipboard text.",
      "args": {
        "type": "object",
        "properties": { "target": { "type": "string" }, "requestId": { "type": "string" } },
        "required": ["target", "requestId"],
        "additionalProperties": false
      }
    },
    {
      "name": "starter.clipboard-write",
      "description": "Send text to the selected computer clipboard.",
      "args": {
        "type": "object",
        "properties": { "target": { "type": "string" }, "requestId": { "type": "string" }, "text": { "type": "string" } },
        "required": ["target", "requestId", "text"],
        "additionalProperties": false
      }
    },
    {
      "name": "starter.apps-list",
      "description": "Ask the selected computer for its safe showcase application list.",
      "args": {
        "type": "object",
        "properties": { "target": { "type": "string" }, "requestId": { "type": "string" } },
        "required": ["target", "requestId"],
        "additionalProperties": false
      }
    },
    {
      "name": "starter.apps-open",
      "description": "Ask the selected computer to open a registered application.",
      "args": {
        "type": "object",
        "properties": { "target": { "type": "string" }, "requestId": { "type": "string" }, "appId": { "type": "string" } },
        "required": ["target", "requestId", "appId"],
        "additionalProperties": false
      }
    },
    {
      "name": "starter.response-poll",
      "description": "Read the execution result of a Starter showcase request.",
      "args": {
        "type": "object",
        "properties": { "requestId": { "type": "string" } },
        "required": ["requestId"],
        "additionalProperties": false
      }
    }
  ],
  "events": [
    { "name": "_plugin.@synra-plugin/starter.open-url", "payload": { "type": "object", "required": ["requestId", "url"], "properties": { "requestId": { "type": "string", "maxLength": 128 }, "url": { "type": "string", "maxLength": 2048 } }, "additionalProperties": false } },
    { "name": "_plugin.@synra-plugin/starter.clipboard-read-selection", "payload": { "type": "object", "required": ["requestId"], "properties": { "requestId": { "type": "string", "maxLength": 128 } }, "additionalProperties": false } },
    { "name": "_plugin.@synra-plugin/starter.clipboard-write", "payload": { "type": "object", "required": ["requestId", "text"], "properties": { "requestId": { "type": "string", "maxLength": 128 }, "text": { "type": "string", "maxLength": 65536 } }, "additionalProperties": false } },
    { "name": "_plugin.@synra-plugin/starter.apps-list", "payload": { "type": "object", "required": ["requestId"], "properties": { "requestId": { "type": "string", "maxLength": 128 } }, "additionalProperties": false } },
    { "name": "_plugin.@synra-plugin/starter.apps-open", "payload": { "type": "object", "required": ["requestId", "appId"], "properties": { "requestId": { "type": "string", "maxLength": 128 }, "appId": { "type": "string", "maxLength": 128 } }, "additionalProperties": false } },
    { "name": "_plugin.@synra-plugin/starter.response", "payload": { "type": "object", "required": ["requestId", "status"], "properties": { "requestId": { "type": "string", "maxLength": 128 }, "status": { "type": "string", "maxLength": 16 }, "code": { "type": "string", "maxLength": 64 }, "message": { "type": "string", "maxLength": 256 }, "value": {} }, "additionalProperties": false } }
  ],
  "handles": [
    { "event": "_plugin.@synra-plugin/starter.*" }
  ]
}
